    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0"
  }
